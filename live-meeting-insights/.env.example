# Copy to .env (gitignored). Keys come from the environment only; never commit them.

# Where the server listens. 127.0.0.1 keeps everything on this Mac.
# Set 0.0.0.0 to open the insights panel on your iPhone over the same Wi-Fi.
HOST=127.0.0.1
PORT=8787

# Required for any non-loopback access (the iPhone). Generate one with:
#   openssl rand -hex 16
ACCESS_TOKEN=

# Write each channel to sessions/<id>/audio-<channel>.wav. Off by default:
# raw audio is not kept on disk unless you are testing capture.
SAVE_TEST_AUDIO=false

# Defaults to ./sessions
# SESSIONS_DIR=

# Milestone 2 onwards.
# DEEPGRAM_API_KEY=
# ANTHROPIC_API_KEY=
